# Copy to .env.local and fill in. Never commit real values.

# Absolute site URL, no trailing slash (required for production builds).
NEXT_PUBLIC_SITE_URL=https://vernonweehong.com
# "production" turns on indexing and hides draft posts.
NEXT_PUBLIC_APP_ENVIRONMENT=development
# Optional: Google Search Console verification code (the content of its meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contact form (SMTP).
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO=

# Email updates: Buttondown free plan, one newsletter, bilingual emails (Phase 1).
# Buttondown → API → Keys (https://buttondown.com/keys).
BUTTONDOWN_API_KEY=
