{
	"name": "vernon-koh-portfolio",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"format": "prettier \"{app,components,lib,e2e,__tests__}/**/*.{ts,tsx}\" --write",
		"test": "vitest run --passWithNoTests && playwright test --pass-with-no-tests",
		"test:unit": "vitest",
		"test:unit:run": "vitest run --passWithNoTests",
		"test:unit:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:report": "playwright show-report",
		"storybook": "storybook dev -p 6006",
		"storybook:build": "storybook build",
		"commitlint": "commitlint --edit",
		"commitizen": "exec < /dev/tty && git cz --hook || true",
		"prepare": "husky",
		"setup": "npx playwright install",
		"job-resume": "node scripts/job-resume.mjs"
	},
	"dependencies": {
		"@mdx-js/mdx": "^3.1.1",
		"@react-pdf/renderer": "^4.9.0",
		"@tanstack/react-query": "^5.107.1",
		"next": "16.4.5",
		"nodemailer": "^10.4.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"shiki": "^4.6.0",
		"unified": "^11.0.5",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@playwright/test": "^1.65.0",
		"@storybook/addon-docs": "^10.6.6",
		"@storybook/addon-links": "^10.6.6",
		"@storybook/addon-themes": "^10.6.6",
		"@storybook/nextjs-vite": "^10.6.6",
		"@tailwindcss/turbopack": "^4.3.5",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^26.6.6",
		"@types/nodemailer": "^8.0.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"@vitest/coverage-v8": "^5.1.0",
		"commitizen": "^4.3.2",
		"cz-conventional-changelog": "^3.3.0",
		"eslint": "^10.14.0",
		"eslint-config-next": "16.4.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.6.6",
		"eslint-plugin-unicorn": "^79.0.0",
		"husky": "^9.1.7",
		"jiti": "^2.7.0",
		"jsdom": "^31.0.0",
		"prettier": "^3.9.10",
		"schema-dts": "^2.1.0",
		"storybook": "^10.6.6",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^5.1.0"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	}
}
